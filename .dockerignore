# Version-control and local development metadata
.git/
.github/
.vscode/
.idea/

# Secrets and local runtime configuration
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Python caches, virtual environments, and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
venv/
env/
.venv/

# Runtime state, logs, and uploads must be mounted externally at /data
*.log
nohup.out
/data/
/uploads/

# Documentation and local-only build metadata are not required at runtime
/docs/
README.md
railway.json
docker-compose.yml
compose.yml
