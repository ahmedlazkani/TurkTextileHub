# =============================================================================
# TopKap Telegram Bot — Production Environment Template
# =============================================================================
# DevOps: copy this file to a protected server-side .env file or inject the
# equivalent values through the company's secret manager. Never commit the
# resulting .env file, never send it in chat, and never bake it into an image.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime and public HTTPS address
# -----------------------------------------------------------------------------
# Set to production on the company server. The application then fails fast when
# required configuration is absent instead of starting in a broken state.
APP_ENV=production

# The externally reachable HTTPS URL used by Telegram Mini App buttons.
# Example: https://bot.company.example
PUBLIC_BASE_URL=https://bot.example.com

# The application listens on this internal container port. Docker Compose maps
# it to the reverse proxy; do not expose it publicly without TLS.
PORT=8080

# -----------------------------------------------------------------------------
# Telegram — REQUIRED SECRET
# -----------------------------------------------------------------------------
# Obtain from @BotFather. Use TELEGRAM_BOT_TOKEN as the canonical name.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# Telegram numeric ID allowed to receive administrator alerts.
ADMIN_TELEGRAM_ID=replace-with-admin-telegram-id

# Base URL used by the TopKap app to connect a supplier Telegram account.
TELEGRAM_BOT_CONNECT_BASE_URL=https://t.me/TopKapTR_bot?start=

# -----------------------------------------------------------------------------
# KAYISOFT — REQUIRED SECRET AND SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
# Production API URL supplied by KAYISOFT. Do not use the development API in
# the company production environment.
KAYISOFT_API_URL=https://api-wholesale.example.com

# Canonical server-to-server bearer token for KAYISOFT API calls.
KAYISOFT_API_TOKEN=replace-with-kayisoft-api-token

# Optional compatibility alias. Set only when KAYISOFT requires this name;
# when both are present, TELEGRAM_BOT_API_ENDPOINT_KEY is preferred by legacy code.
# TELEGRAM_BOT_API_ENDPOINT_KEY=replace-with-kayisoft-api-token

# -----------------------------------------------------------------------------
# AI — AT LEAST ONE PROVIDER KEY IS REQUIRED FOR AI-ASSISTED ENTRY
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional OpenAI-compatible fallback.
# OPENAI_API_KEY=replace-with-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# FALLBACK_AI_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------------
# TopKap / TopGate public links
# -----------------------------------------------------------------------------
TOPKAP_APP_URL=https://topkap.example.com
# TOPKAP_ORDERS_URL=https://topkap.example.com/orders
TOPGATE_WEB_URL=https://topgate.example.com

# -----------------------------------------------------------------------------
# Webhook verification — set when the corresponding endpoint is enabled
# -----------------------------------------------------------------------------
# KAYISOFT_WEBHOOK_SECRET=replace-with-kayisoft-webhook-secret
# ORDERS_WEBHOOK_SECRET=replace-with-orders-webhook-secret

# -----------------------------------------------------------------------------
# Persistent application state — REQUIRED IN PRODUCTION
# -----------------------------------------------------------------------------
# /data must be mounted as a persistent Docker volume or encrypted host path.
CHANNELS_FILE=/data/user_channels.json
LANGS_FILE=/data/user_langs.json

# -----------------------------------------------------------------------------
# Legacy compatibility names — do not use for a new company deployment
# -----------------------------------------------------------------------------
# BOT_TOKEN=legacy-telegram-token-name
# KAYISOFT_API_KEY=legacy-kayisoft-token-name
# KAYISOFT_API_BASE_URL=https://legacy-kayisoft-api.example.com
# RAILWAY_DOMAIN=legacy-hostname
# RAILWAY_PUBLIC_DOMAIN=legacy-hostname
# RAILWAY_STATIC_URL=https://legacy-hostname
